# توکن ربات که از @BotFather می‌گیرید
TELEGRAM_BOT_TOKEN=123456:ABC-your-telegram-token

# کلید API از https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-key

# مدل Claude (اختیاری). ارزان‌ترین: claude-haiku-4-5
# اگر جواب‌ها دقیق نبود: claude-sonnet-5-5 (حدود ۲ برابر گران‌تر)
CLAUDE_MODEL=claude-haiku-4-5

# عمق فکر کردن برای Sonnet/Opus: low / medium / high / xhigh / max (روی Haiku اثری ندارد)
CLAUDE_EFFORT=low

# آیدی عددی تلگرام کسانی که اجازهٔ استفاده دارند، با کاما جدا شود.
# خالی = همه می‌توانند استفاده کنند. آیدی خودتان را با /myid در ربات ببینید.
ALLOWED_USER_IDS=

# تعداد پیام‌های قبلی که به عنوان حافظهٔ گفتگو فرستاده می‌شود (اختیاری)
HISTORY_LENGTH=10
